---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Sidebar } from '../components/Sidebar';
import { MobileTabBar } from '../components/MobileTabBar';

interface Props {
  title?: string;
  activeTab?: string;
}

const { title = "Dashboard", activeTab = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{title}</title>
    <meta id="theme-color-meta" name="theme-color" content="#f4f5f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <ClientRouter />
    
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const applyTheme = (theme) => {
        const root = document.documentElement;
        if (theme === 'dark') {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
        const metaThemeColor = document.getElementById('theme-color-meta');
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', theme === 'dark' ? '#0c0e14' : '#f4f5f8');
        }
      };

      applyTheme(getThemePreference());

      // Сброс скролла и восстановление темы после перехода Astro
      document.addEventListener('astro:after-swap', () => {
        applyTheme(getThemePreference());
        document.body.style.overflow = '';
        
        const scrollContainer = document.getElementById('main-scroll-container');
        if (scrollContainer) {
          scrollContainer.scrollTop = 0;
        }
      });
    </script>
  </head>
  <body class="bg-canvas text-text-main antialiased selection:bg-blue-500/20">
    <div class="min-h-dvh h-dvh bg-canvas text-text-main flex flex-col md:flex-row overflow-hidden">
      {/* Сайдбар сохраняется между страницами */}
      <Sidebar 
        client:load 
        transition:persist="desktop-sidebar" 
        transition:name="desktop-sidebar"
        activeTab={activeTab} 
      />

      {/* Скролл-контейнер для страниц */}
      <main 
        id="main-scroll-container"
        class="flex-1 h-full overflow-y-auto overflow-x-hidden p-4 pb-28 md:p-6 md:pb-6 lg:p-8 lg:pb-8"
      >
        {/* Анимируется только содержимое этого контейнера */}
        <div 
          transition:name="page-content"
          class="max-w-6xl mx-auto min-h-full"
        >
          <slot />
        </div>
      </main>

      {/* Таб-бар сохраняется между страницами */}
      <MobileTabBar 
        client:load 
        transition:persist="mobile-tabbar" 
        transition:name="mobile-tabbar"
        activeTab={activeTab} 
      />
    </div>
  </body>
</html>