---
import '../styles/global.css';
import { App } from '../components/App';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'journal' } },
    { params: { slug: 'playbook' } },
    { params: { slug: 'system' } },
    { params: { slug: 'stats' } },
    { params: { slug: 'settings' } },
    { params: { slug: 'login' } },
  ];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Trading Journal</title>
    <meta id="theme-color-meta" name="theme-color" content="#f4f5f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme') || 
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          const meta = document.getElementById('theme-color-meta');
          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? '#0c0e14' : '#f4f5f8');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-canvas text-text-main antialiased selection:bg-blue-500/20">
    <App client:only="react" />
  </body>
</html>

