---
import '../styles/global.css';
import { App } from '../components/App';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'journal' } },
    { params: { slug: 'playbook' } },
    { params: { slug: 'system' } },
    { params: { slug: 'stats' } },
    { params: { slug: 'settings' } },
    { params: { slug: 'login' } },
  ];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Trading Journal</title>
    <meta id="theme-color-meta" name="theme-color" content="#f4f5f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Journal" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.error('[PWA SW] Registration failed:', err);
          });
        });
      }
    </script>
    <script is:inline>
      (function() {
        try {
          const mode = localStorage.getItem('theme_mode') || localStorage.getItem('theme') || 'system';
          let activeTheme = 'light';

          if (mode === 'dark') {
            activeTheme = 'dark';
          } else if (mode === 'light') {
            activeTheme = 'light';
          } else if (mode === 'time') {
            const rawDay = localStorage.getItem('theme_day_start');
            const rawNight = localStorage.getItem('theme_night_start');
            const dayStart = rawDay !== null ? parseInt(rawDay, 10) : 7;
            const nightStart = rawNight !== null ? parseInt(rawNight, 10) : 20;
            const hour = new Date().getHours();
            const isDay = dayStart <= nightStart
              ? (hour >= dayStart && hour < nightStart)
              : (hour >= dayStart || hour < nightStart);
            activeTheme = isDay ? 'light' : 'dark';
          } else {
            // 'system'
            activeTheme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }

          if (activeTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          const meta = document.getElementById('theme-color-meta');
          if (meta) {
            meta.setAttribute('content', activeTheme === 'dark' ? '#0c0e14' : '#f4f5f8');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-canvas text-text-main antialiased selection:bg-blue-500/20">
    <App client:only="react" />
  </body>
</html>

